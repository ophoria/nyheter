/* Nyheter help – हिन्दी. Keys are ids; values use **bold**, *italic* and [links](url) (Markdown). Keep UI names identical to Localizable.strings. */

"help.button" = "सहायता";
"help.title" = "सहायता";
"help.kicker" = "Nyheter · गाइड";
"help.headline" = "जो कुछ चाहिए, बस पाँच मिनट में।";
"help.lede" = "Nyheter तुम्हारे Mac के स्क्रीन सेवर को एक शांत ख़बरों के बोर्ड में बदल देता है। ऐप उसका रिमोट कंट्रोल है। यहाँ जानो कि हर हिस्सा कैसे काम करता है।";
"help.search" = "सहायता में खोजें";
"help.contents" = "विषय-सूची";
"help.noResults" = "कुछ नहीं मिला। कोई दूसरा शब्द आज़माओ।";
"help.intro.title" = "Nyheter क्या है?";
"help.intro.body" = "जब तुम्हारा Mac आराम करता है, तो स्क्रीन सेवर ताज़ा ख़बरें दिखाता है – एक बार में एक ख़बर, बड़ी और पढ़ने में आसान।\n\n**Nyheter ऐप** में तुम सब कुछ तय करते हो: कौन-सी ख़बरें, हर ख़बर कितनी देर रहे, वह कैसी दिखे और क्या छिपाना है।\n\nहर बदलाव तुरंत ऐप के ऊपर वाले प्रीव्यू में दिखता है – और स्क्रीन सेवर में भी।";
"help.start.title" = "शुरू करो";
"help.start.body" = "1. **स्क्रीन सेवर इंस्टॉल करें** पर क्लिक करो।\n2. **सिस्टम सेटिंग्ज़ › स्क्रीन सेवर** खोलो और **Nyheter** चुनो।\n3. अभी देखना है? **फ़ुल स्क्रीन में दिखाएँ** पर क्लिक करो। बाहर आने के लिए कोई भी की दबाओ।\n\nबस इतना ही। ख़बरें अपने-आप अपडेट होती रहती हैं।";
"help.app.title" = "क्या मैं ऐप बंद कर सकता हूँ?";
"help.app.body" = "हाँ। स्क्रीन सेवर अपने आप चलता है: यह तुम्हारी सेटिंग्ज़ पढ़ता है, ख़बरें लाता है और ऐप के बिना उन्हें सहेजता है। ऐप सिर्फ़ रिमोट कंट्रोल है, इसलिए सेटिंग्ज़ पूरी होने पर तुम इसे बंद कर सकते हो।

ऐप फिर से तब खोलो जब तुम्हें:
• **सेटिंग्ज़ बदलनी हों।** चलता हुआ स्क्रीन सेवर कुछ ही सेकंड में बदलाव ले लेता है।
• ऐप का नया संस्करण मिलने के बाद **स्क्रीन सेवर अपडेट करें** पर क्लिक करना हो।

अगर Nyheter दिखना बंद हो जाए, जैसे macOS अपडेट के बाद, तो उसे **सिस्टम सेटिंग्ज़ › स्क्रीन सेवर** में फिर से चुनो।";
"help.sources.title" = "अपनी ख़बरें चुनो";
"help.sources.body" = "**स्रोत** टैब पर जाओ।\n\n• कोई अख़बार या चैनल जोड़ने के लिए **स्रोत जोड़ें** पर क्लिक करो, जैसे SVT, BBC या The New York Times।\n• हर स्रोत के अपने स्विच होते हैं, जैसे **दुनिया** या **खेल**। जो पसंद हो, उसे चालू करो।\n• किसी स्रोत को हटाने के लिए **हटाएँ** पर क्लिक करो। Nyheter उसकी सेटिंग्ज़ याद रखता है, तो दोबारा जोड़ने पर वे लौट आती हैं।\n• छोटा-सा चेतावनी चिह्न मतलब वह फ़ीड अभी जवाब नहीं दे रही। अक्सर यह अपने-आप ठीक हो जाता है।\n\nतुम्हें सिर्फ़ उन्हीं स्रोतों के विकल्प दिखते हैं जिन्हें तुम इस्तेमाल करते हो।";
"help.order.title" = "क्रम";
"help.order.body" = "**क्रम** में तुम तय करते हो कि स्रोत कैसे मिलें।\n\n• **बारी-बारी से** – हर स्रोत से एक ख़बर, तुम्हारे चुने हुए चक्कर में। किसी स्रोत को ज़्यादा बार देखना हो तो उसे दो बार जोड़ो।\n• **क्रम से** – पहले एक स्रोत की सारी ख़बरें, फिर अगले की। स्रोतों को खींचकर अपने मनचाहे क्रम में रखो।\n• **यादृच्छिक** – सब कुछ मिला-जुला।\n\n**प्रति स्रोत अधिकतम** किसी एक स्रोत को पूरी स्क्रीन पर छा जाने से रोकता है।";
"help.counter.title" = "कोने में अंक";
"help.counter.body" = "हर ख़बर के नीचे दाईं ओर तुम्हें कुछ ऐसा दिखता है: **12 / 48**।\n\n• पहला अंक स्क्रीन पर दिख रही ख़बर है।\n• दूसरा अंक बताता है कि अभी चक्कर में कितनी ख़बरें हैं।\n\nचक्कर आख़िरी बार लाई गई ख़बरें हैं, उन्हें हटाकर जो तुम नहीं चाहते: सिर्फ़ चालू स्रोत, तुम्हारे **फ़िल्टर** से छिपी ख़बरें नहीं, हर ख़बर एक बार, और हर स्रोत से ज़्यादा से ज़्यादा **प्रति स्रोत अधिकतम** (**क्रम** में)। कुछ स्रोतों की अपनी सीमा भी **स्रोत** में होती है।\n\nआख़िरी ख़बर के बाद चक्कर फिर 1 से शुरू होता है। हर नई बार ख़बरें लाने पर यह फिर से बनता है, इसलिए दूसरा अंक बदल सकता है। लाइव अंकों वाली स्लाइड पर गिनती छिपी रहती है।";
"help.time.title" = "स्क्रीन पर समय";
"help.time.body" = "**समय** में तुम चुनते हो कि हर ख़बर कितनी देर रहे।\n\n• कोई तय समय चुनो, जैसे 15 सेकंड।\n• या **समय को टेक्स्ट की लंबाई के अनुसार ढालें** चालू करो: लंबी ख़बरें ज़्यादा देर रुकती हैं, छोटी जल्दी निकल जाती हैं। तुम कम से कम और ज़्यादा से ज़्यादा समय तय करते हो, ताकि कुछ भी झट से न भागे और न ही अटका रहे।";
"help.look.title" = "थीम और लेआउट";
"help.look.body" = "**थीम** में तुम लुक चुनते हो – सुबह के हल्के अख़बार से लेकर चमकते हरे कोड तक।\n\n• **हर बार स्क्रीन सेवर शुरू होने पर कोई यादृच्छिक थीम चुनें** से हर बार एक सरप्राइज़ मिलता है। जो थीम पसंद हों, उन पर टिक करो।\n• **दाएँ कॉलम में आने वाली ख़बरें दिखाएँ** बताता है कि आगे क्या आने वाला है।\n• **केवल हेडलाइन दिखाएँ** हेडलाइन को बड़ा कर देता है और बाक़ी टेक्स्ट छिपा देता है।\n• **नीचे प्रगति रेखा दिखाएँ** बताता है कि हर ख़बर का कितना समय बचा है।";
"help.filters.title" = "जो नहीं चाहिए, उसे छिपाओ";
"help.filters.body" = "**फ़िल्टर** में तुम चुनते हो कि क्या कभी न दिखे।\n\n• कोई शब्द लिखो, जैसे *फ़ुटबॉल*, और **जोड़ें** पर क्लिक करो। उस शब्द वाली हर ख़बर ग़ायब हो जाती है।\n• और ताक़त चाहिए? **रेगुलर एक्सप्रेशन** चुनो। उदाहरण: *(फ़ुटबॉल|हॉकी)* दोनों शब्द छिपा देता है।\n• **पूरे सेक्शन छिपाएँ** एक साथ, जैसे, संस्कृति या खेल की सारी ख़बरें हटा देता है।\n• अगर तुम एक से ज़्यादा भाषाओं में ख़बरें पढ़ते हो, तो **लागू होता है** से कोई फ़िल्टर सिर्फ़ एक भाषा पर काम कर सकता है।\n\n**लॉग** दिखाता है कि क्या छिपाया गया और क्यों। जिस शब्द की वजह से ऐसा हुआ, वह **लाल** रंग में दिखता है। पूरा लॉग बड़ी विंडो में देखने के लिए **बड़ा खोलें** पर क्लिक करो।";
"help.fetched.title" = "क्या-क्या लाया गया";
"help.fetched.body" = "**लाई गईं** टैब में वे सारी ख़बरें हैं जो Nyheter ने डाउनलोड कीं, सबसे नई सबसे ऊपर।\n\n• सिर्फ़ वे ख़बरें देखने के लिए जो स्क्रीन सेवर दिखाएगा, **केवल दिखाई गई** पर टिक करें।\n• **#12** जैसा नंबर बताता है कि क़तार में उसकी जगह कौन-सी है।\n• लाल फ़िल्टर चिह्न का मतलब है कि किसी फ़िल्टर ने उसे छिपा दिया।\n• किसी ख़बर पर क्लिक करो और उसे अख़बार की वेबसाइट पर पढ़ो।";
"help.world.title" = "इस समय दुनिया";
"help.world.body" = "हर कुछ ख़बरों के बाद Nyheter लाइव नंबर दिखा सकता है – जैसे इस समय धरती पर कितने लोग रहते हैं। तुम देखते रहो, और वे बढ़ते जाते हैं।\n\nये नंबर आधिकारिक सालाना आँकड़ों से बने समझदार अनुमान हैं, बिल्कुल सटीक गिनती नहीं। **दुनिया** टैब में चुनो कि तुम्हें कौन-से चाहिए।";
"help.language.title" = "भाषा";
"help.language.body" = "Nyheter अपने-आप तुम्हारे Mac की भाषा बोलता है। कोई दूसरी चाहिए? झंडों वाले **भाषा मेनू** में से चुनो।\n\nख़बरें ख़ुद हर अख़बार की अपनी भाषा में ही रहती हैं।";
"help.clock.title" = "ऊपर वाली घड़ी";
"help.clock.body" = "macOS स्क्रीन सेवर के ऊपर एक बड़ी घड़ी दिखाता है। Nyheter उसे नहीं हटा सकता, पर तुम हटा सकते हो: **घड़ी…** पर क्लिक करो और **बड़ी घड़ी दिखाएँ** को **लॉक स्क्रीन पर** या **कभी नहीं** पर सेट करो।";
"help.clock.body.wallpaper" = "macOS स्क्रीन सेवर के ऊपर एक बड़ी घड़ी दिखाता है। Nyheter उसे नहीं हटा सकता, पर तुम हटा सकते हो: **घड़ी…** पर क्लिक करो, फिर **घड़ी का प्रकटन…** पर, और **बड़ी घड़ी दिखाएँ** को **लॉक स्क्रीन पर** या **कभी नहीं** पर सेट करो।";
"help.trouble.title" = "अगर कुछ गड़बड़ लगे";
"help.trouble.body" = "• **सिर्फ़ “ख़बरें ला रहा है…” दिख रहा है?** अपना इंटरनेट कनेक्शन जाँचो और देखो कि कम से कम एक स्रोत चालू हो।\n• **कोई स्रोत जवाब नहीं दे रहा?** थोड़ी देर रुको। अख़बार कभी-कभी बहुत ज़्यादा विज़िट रोक देते हैं।\n• **ख़बरें बहुत कम हैं?** **फ़िल्टर** में अपने फ़िल्टर और छिपे हुए सेक्शन देखो।\n• **स्क्रीन सेवर पुराना लग रहा है?** **स्क्रीन सेवर अपडेट करें** पर क्लिक करो।";
"help.about.title" = "Nyheter के बारे में";
"help.about.body" = "Nyheter को **snowdrop** ने बनाया है।\n\nकोई आइडिया है, कोई बग मिला या बस हैलो कहना है? **[contact@gaia.li](mailto:contact@gaia.li)** पर लिखो। हर मैसेज पढ़ा जाता है।";

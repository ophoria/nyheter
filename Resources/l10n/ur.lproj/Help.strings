"help.intro.title" = "Nyheter کیا ہے؟";
"help.intro.body" = "جب آپ کا Mac آرام کرتا ہے تو اسکرین سیور تازہ ترین خبریں دکھاتا ہے – ایک وقت میں ایک، بڑی اور پڑھنے میں آسان۔\n\n**Nyheter ایپ** میں آپ سب کچھ طے کرتے ہیں: کون سی خبریں، ہر خبر کتنی دیر رہے، کیسی دکھے اور کیا چھپانا ہے۔\n\nہر تبدیلی فوراً ایپ کے اوپر والے پیش منظر میں نظر آتی ہے – اور اسکرین سیور میں بھی۔";
"help.start.title" = "شروع کریں";
"help.start.body" = "1. **اسکرین سیور انسٹال کریں** پر کلک کریں۔\n2. **سسٹم سیٹنگز › اسکرین سیور** کھولیں اور **Nyheter** چنیں۔\n3. ابھی دیکھنا ہے؟ **پوری اسکرین پر دکھائیں** پر کلک کریں۔ باہر نکلنے کے لیے کوئی بھی کی دبائیں۔\n\nبس اتنا ہی۔ خبریں خود بخود اپ ڈیٹ ہوتی ہیں۔";
"help.app.title" = "کیا میں ایپ بند کر سکتا ہوں؟";
"help.app.body" = "جی ہاں۔ اسکرین سیور خود چلتا ہے: یہ آپ کی سیٹنگز پڑھتا ہے، خبریں لاتا ہے اور ایپ کے بغیر انہیں محفوظ کرتا ہے۔ ایپ صرف ریموٹ کنٹرول ہے، اس لیے سیٹنگز مکمل ہونے پر آپ اسے بند کر سکتے ہیں۔

ایپ دوبارہ تب کھولیں جب آپ چاہیں:
• **سیٹنگز بدلنا۔** چلتا ہوا اسکرین سیور چند سیکنڈ میں تبدیلی لے لیتا ہے۔
• ایپ کا نیا ورژن ملنے کے بعد **اسکرین سیور اپ ڈیٹ کریں** پر کلک کرنا۔

اگر Nyheter دکھنا بند ہو جائے، مثلاً macOS اپ ڈیٹ کے بعد، تو اسے **سسٹم سیٹنگز › اسکرین سیور** میں دوبارہ چنیں۔";
"help.sources.title" = "اپنی خبریں چنیں";
"help.sources.body" = "**ذرائع** ٹیب پر جائیں۔\n\n• کوئی اخبار یا چینل شامل کرنے کے لیے **ذریعہ شامل کریں** پر کلک کریں، جیسے SVT، BBC یا The New York Times۔\n• ہر ذریعے کے اپنے سوئچ ہیں، مثلاً **دنیا** یا **کھیل**۔ جو پسند ہو آن کریں۔\n• کوئی ذریعہ ہٹانے کے لیے **ہٹائیں** پر کلک کریں۔ Nyheter اس کی سیٹنگز یاد رکھتا ہے، اس لیے دوبارہ شامل کرنے پر وہ واپس آ جاتی ہیں۔\n• ایک چھوٹا سا انتباہی نشان کا مطلب ہے کہ وہ فیڈ ابھی جواب نہیں دے رہی۔ عام طور پر یہ خود ٹھیک ہو جاتا ہے۔\n• **اپنی فیڈز** میں آپ کسی بھی خبروں کی فیڈ کا پتا چسپاں کر سکتے ہیں، یا ایسی ویب سائٹ کا جس کی فیڈ ہو۔\n\nآپ صرف انہی ذرائع کے آپشن دیکھتے ہیں جو آپ استعمال کرتے ہیں۔";
"help.order.title" = "ترتیب";
"help.order.body" = "**ترتیب** میں آپ طے کرتے ہیں کہ ذرائع کیسے آپس میں ملیں۔\n\n• **باری باری** – ہر ذریعے سے ایک خبر، آپ کے چنے ہوئے چکر میں۔ کوئی ذریعہ زیادہ دیکھنا ہو تو اسے دو بار شامل کریں۔\n• **ترتیب وار** – ایک ذریعے کی ساری خبریں، پھر اگلے کی۔ ذرائع کو کھینچ کر اپنی پسند کی ترتیب میں رکھیں۔\n• **بے ترتیب** – سب کچھ گڈمڈ۔\n\n**فی ذریعہ زیادہ سے زیادہ** کسی ایک ذریعے کو سب پر چھا جانے سے روکتا ہے۔\n\n**ترجیح**: نئی خبریں اور وہ خبریں جو آپ نے ابھی نہیں دیکھیں، پہلے دکھائی جاتی ہیں۔ نگرانی کے الفاظ شامل کریں تاکہ آپ کے موضوعات بھی پہلے آئیں۔";
"help.counter.title" = "کونے میں نمبر";
"help.counter.body" = "ہر خبر کے نیچے دائیں طرف آپ کو کچھ ایسا نظر آتا ہے: **12 / 48**۔\n\n• پہلا نمبر اسکرین پر موجود خبر ہے۔\n• دوسرا نمبر بتاتا ہے کہ اس وقت دور میں کتنی خبریں ہیں۔\n\nدور آخری بار لائی گئی خبریں ہیں، ان کے بغیر جو آپ نہیں چاہتے: صرف آن کیے گئے ذرائع، آپ کے **فلٹرز** سے چھپی خبریں نہیں، ہر خبر ایک بار، اور ہر ذریعے سے زیادہ سے زیادہ **فی ذریعہ زیادہ سے زیادہ** (**ترتیب** میں)۔ کچھ ذرائع کی اپنی حد بھی **ذرائع** میں ہوتی ہے۔\n\nآخری خبر کے بعد دور پھر 1 سے شروع ہوتا ہے۔ ہر نئی بار خبریں لانے پر یہ دوبارہ بنتا ہے، اس لیے دوسرا نمبر بدل سکتا ہے۔ لائیو نمبروں والی سلائیڈز پر گنتی چھپی رہتی ہے۔";
"help.time.title" = "اسکرین پر وقت";
"help.time.body" = "**وقت** میں آپ چنتے ہیں کہ ہر خبر کتنی دیر رہے۔\n\n• ایک مقررہ وقت چنیں، مثلاً 15 سیکنڈ۔\n• یا **وقت کو متن کی لمبائی کے مطابق ڈھالیں** آن کریں: لمبی خبریں زیادہ دیر رہتی ہیں، چھوٹی جلدی چلی جاتی ہیں۔ آپ کم از کم اور زیادہ سے زیادہ وقت طے کرتے ہیں، تاکہ کچھ بھی پلک جھپکتے نہ گزرے اور نہ اٹکا رہے۔";
"help.look.title" = "تھیمز اور لے آؤٹ";
"help.look.body" = "**تھیم** میں آپ شکل چنتے ہیں – صبح کے ہلکے اخبار سے لے کر چمکتے سبز کوڈ تک۔\n\n• **ہر بار اسکرین سیور شروع ہونے پر بے ترتیب تھیم چنیں** ہر بار ایک سرپرائز دیتا ہے۔ پسندیدہ تھیمز پر ٹک لگائیں۔\n• **دائیں کالم میں خبر کا QR کوڈ دکھائیں** ایک QR کوڈ دکھاتا ہے جسے فون سے اسکین کر کے پوری خبر پڑھ سکتے ہیں۔\n• **صرف سرخیاں دکھائیں** سرخی کو بڑا کر دیتا ہے اور باقی متن چھپا دیتا ہے۔\n• **نیچے پیش رفت کی لکیر دکھائیں** دکھاتا ہے کہ ہر خبر کا کتنا وقت باقی ہے۔";
"help.filters.title" = "جو نہیں چاہیے اسے چھپائیں";
"help.filters.body" = "**فلٹرز** میں آپ چنتے ہیں کہ کیا کبھی نہ دکھایا جائے۔\n\n• کوئی لفظ لکھیں، جیسے *فٹ بال*، اور **شامل کریں** پر کلک کریں۔ اس لفظ والی ہر خبر غائب ہو جائے گی۔\n• مزید طاقت چاہیے؟ **ریگولر ایکسپریشن** چنیں۔ مثال: *(فٹ بال|ہاکی)* دونوں لفظ چھپا دیتا ہے۔\n• **پورے حصے چھپائیں** ایک ساتھ، مثلاً، ساری ثقافت یا کھیل کی خبریں ہٹا دیتا ہے۔\n• اگر آپ ایک سے زیادہ زبانوں میں خبریں پڑھتے ہیں تو **لاگو ہوتا ہے** سے کوئی فلٹر صرف ایک زبان پر چلا سکتے ہیں۔\n\n**لاگ** دکھاتا ہے کہ کیا چھپایا گیا اور کیوں۔ جس لفظ کی وجہ سے ایسا ہوا وہ **سرخ** رنگ میں دکھتا ہے۔ پورا لاگ بڑی کھڑکی میں دیکھنے کے لیے **بڑا کھولیں** پر کلک کریں۔";
"help.fetched.title" = "کیا حاصل ہوا";
"help.fetched.body" = "**حاصل شدہ** ٹیب میں وہ سب خبریں ہیں جو Nyheter نے ڈاؤن لوڈ کیں، سب سے نئی پہلے۔\n\n• صرف وہ خبریں دیکھنے کے لیے جو اسکرین سیور دکھائے گا، **صرف دکھائی گئی** پر نشان لگائیں۔\n• **#12** جیسا نمبر قطار میں خبر کی جگہ بتاتا ہے۔\n• سرخ فلٹر کا نشان مطلب ہے کہ کسی فلٹر نے اسے چھپایا۔\n• کسی خبر پر کلک کریں اور اسے اخبار کی ویب سائٹ پر پڑھیں۔";
"help.world.title" = "دنیا اس وقت";
"help.world.body" = "ہر چند خبروں کے بعد Nyheter لائیو نمبر دکھا سکتا ہے – جیسے اس وقت زمین پر کتنے لوگ رہتے ہیں۔ آپ کے دیکھتے دیکھتے یہ بڑھتے رہتے ہیں۔\n\nیہ نمبر سرکاری سالانہ اعداد و شمار سے لگائے گئے سمجھدار اندازے ہیں، بالکل درست گنتی نہیں۔ جو چاہیں **دنیا** ٹیب میں چنیں۔";
"help.language.title" = "زبان";
"help.language.body" = "Nyheter خود بخود آپ کے Mac کی زبان بولتا ہے۔ کوئی اور زبان چاہیے؟ جھنڈوں والے **زبان کے مینو** سے چنیں۔\n\nخبریں خود ہر اخبار کی اپنی زبان میں رہتی ہیں۔";
"help.clock.title" = "اوپر والی گھڑی";
"help.clock.body" = "macOS اسکرین سیور کے اوپر ایک بڑی گھڑی دکھاتا ہے۔ Nyheter اسے نہیں ہٹا سکتا، لیکن آپ ہٹا سکتے ہیں: **گھڑی…** پر کلک کریں اور **بڑی گھڑی دکھائیں** کو **لاک اسکرین پر** یا **کبھی نہیں** پر سیٹ کریں۔";
"help.clock.body.wallpaper" = "macOS اسکرین سیور کے اوپر ایک بڑی گھڑی دکھاتا ہے۔ Nyheter اسے نہیں ہٹا سکتا، لیکن آپ ہٹا سکتے ہیں: **گھڑی…** پر کلک کریں، پھر **گھڑی کی شکل…** پر، اور **بڑی گھڑی دکھائیں** کو **لاک اسکرین پر** یا **کبھی نہیں** پر سیٹ کریں۔";
"help.trouble.title" = "اگر کچھ غلط لگے";
"help.trouble.body" = "• **صرف “خبریں حاصل ہو رہی ہیں…”؟** اپنا انٹرنیٹ کنکشن چیک کریں اور دیکھیں کہ کم از کم ایک ذریعہ آن ہو۔\n• **کوئی ذریعہ جواب نہیں دے رہا؟** تھوڑا انتظار کریں۔ اخبار کبھی کبھی بہت زیادہ وزٹ روک دیتے ہیں۔\n• **خبریں بہت کم ہیں؟** **فلٹرز** میں اپنے فلٹر اور چھپے ہوئے حصے دیکھیں۔\n• **اسکرین سیور پرانا لگ رہا ہے؟** **اسکرین سیور اپ ڈیٹ کریں** پر کلک کریں۔";
"help.about.title" = "Nyheter کے بارے میں";
"help.about.body" = "Nyheter کو **snowdrop** نے بنایا ہے۔\n\nکوئی خیال ہے، کوئی خرابی ملی، یا بس سلام کہنا ہے؟ **[contact@gaia.li](mailto:contact@gaia.li)** پر لکھیں۔ ہر پیغام پڑھا جاتا ہے۔";
